# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=https://example.execute-api.ap-south-1.amazonaws.com
# Cognito User Pool ID
VITE_COGNITO_USER_POOL_ID=ap-south-1_ExamplePoolId
# Cognito App Client ID (no secret)
VITE_COGNITO_CLIENT_ID=exampleclientid123
# Full Cognito hosted domain from the stack output `CognitoDomain`
# (e.g. aicfo-dev-123456789012.auth.ap-south-1.amazoncognito.com).
# Leave empty until Google login is enabled.
VITE_COGNITO_DOMAIN=
# OAuth redirect URL (must match the FrontendCallbackUrls template parameter)
VITE_OAUTH_REDIRECT_URL=http://localhost:5173/login
# Dev-only mocks: set to 'true' for local dev with the MSW mock API + fake auth.
# Leave 'false' for any real-backend or production build.
VITE_USE_MOCKS=false
# Optional demo login credentials for the "Try the Demo" button on the login page.
# Only needed against a real (non-mock) backend — point at a real, pre-seeded demo Cognito user once one exists.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
